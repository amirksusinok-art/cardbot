# Port to listen on (Render automatically sets PORT)
PORT=3000

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Public URL of the deployed application (e.g. https://your-app-name.onrender.com)
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# PostgreSQL Connection String (Render Postgres provides this automatically via DATABASE_URL)
# If omitted or empty, the application automatically uses a local SQLite database in ./data/cardbot.db
DATABASE_URL=
